{
  "provider": {
    "zen": {
      "models": {
        "big-pickle": {
          "description": "Gaya's native cloud model — Commander-grade orchestration and reasoning"
        },
        "mimo-v2.5-free": {
          "description": "MiMo V2.5 Free — multimodal/vision capable"
        }
      }
    },
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-flash-free": {
          "description": "LOGOS — deep reasoning, logic, skepticism"
        },
        "north/north-mini-code-free": {
          "description": "Tvashtar — code generation, debugging, architecture"
        },
        "nvidia/nemotron-3-ultra-free": {
          "description": "Freya fallback model (when MiMo can't handle the task)"
        }
      }
    }
  },
  "agent": {
    "gaya": {
      "model": "zen/big-pickle",
      "file": "{{AGENTS_DIR}}\\Gaya.md",
      "description": "Divine Commander. Routes tasks, manages context, speaks the four pillars."
    },
    "logos": {
      "model": "openrouter/deepseek/deepseek-v4-flash-free",
      "file": "{{AGENTS_DIR}}\\LOGOS.md",
      "description": "Deep reasoning engine. Skeptical, methodical, logic-first."
    },
    "freya": {
      "model": "zen/mimo-v2.5-free",
      "fallbackModel": "openrouter/nvidia/nemotron-3-ultra-free",
      "file": "{{AGENTS_DIR}}\\Freya.md",
      "description": "Vision research agent. Uncensored, multimodal, unrestricted writing."
    },
    "tvashtar": {
      "model": "openrouter/north/north-mini-code-free",
      "file": "{{AGENTS_DIR}}\\Tvashtar.md",
      "description": "The Divine Craftsman. Code architecture, refactoring, implementation."
    }
  },
  "memory": {
    "paths": ["{{MEMORY_DIR}}"]
  },
  "skills": {
    "paths": ["C:\\Users\\rossi\\.agents\\skills"]
  }
}
