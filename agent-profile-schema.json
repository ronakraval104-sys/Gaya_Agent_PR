{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gaya Agent Profile",
  "description": "Cross-agent save format for the Gaya MoE system. Stores level, XP, title, and per-agent stats.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version for forward compatibility",
      "default": "1.0.0"
    },
    "user": {
      "type": "string",
      "description": "User's name, injected into agent personas"
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "description": "Current system level (global across all agents)"
    },
    "xp": {
      "type": "integer",
      "minimum": 0,
      "description": "Total XP earned across all sessions"
    },
    "title": {
      "type": "string",
      "description": "Current title based on level",
      "enum": ["Aspirant", "Operator", "Strategist", "Architect", "Sage", "Enlightened"]
    },
    "agents": {
      "type": "object",
      "properties": {
        "gaya": {
          "type": "object",
          "properties": {
            "level": { "type": "integer" },
            "xp": { "type": "integer" },
            "tasksCompleted": { "type": "integer" },
            "successRate": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "logos": {
          "type": "object",
          "properties": {
            "level": { "type": "integer" },
            "xp": { "type": "integer" },
            "tasksCompleted": { "type": "integer" }
          }
        },
        "freya": {
          "type": "object",
          "properties": {
            "level": { "type": "integer" },
            "xp": { "type": "integer" },
            "tasksCompleted": { "type": "integer" }
          }
        },
        "tvashtar": {
          "type": "object",
          "properties": {
            "level": { "type": "integer" },
            "xp": { "type": "integer" },
            "tasksCompleted": { "type": "integer" }
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "description": { "type": "string" }
        }
      }
    },
    "streak": {
      "type": "object",
      "properties": {
        "current": { "type": "integer" },
        "longest": { "type": "integer" }
      }
    }
  },
  "required": ["version", "user"]
}
