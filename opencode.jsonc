{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "Gaya",

  // ═══════════════════════════════════════════════════════════════════
  // STANDARD MODE — Gaya-Agent repo config
  // ═══════════════════════════════════════════════════════════════════
  // Mirrors ~/.config/opencode/opencode.jsonc for cross-session continuity
  // ═══════════════════════════════════════════════════════════════════

  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],

  "skills": {
    "paths": [
      "${HOME}/.agents/skills",
      "${HOME}/.config/opencode/skills",
      "${PROJECT_ROOT}/skills"
    ]
  },

  // ═══════════════════════════════════════════════════════════════════
  // PROVIDERS
  // ═══════════════════════════════════════════════════════════════════
  "provider": {
    "zen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1"
      },
      "models": {
        "big-pickle": {
          "name": "Big Pickle — Gaya (Commander, Philosopher, Poet)",
          "limit": {
            "context": 200000,
            "output": 128000
          }
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "$OPENROUTER_API_KEY"
      },
      "models": {
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro — Gaya Backup",
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        },
        "qwen/qwen3-coder": {
          "name": "Qwen 3 Coder — Bob",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "qwen/qwen3.6-plus": {
          "name": "Qwen 3.6 Plus — Freya Backup",
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    },
    "googleai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Google AI (Gemini)",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "apiKey": "$GEMINI_API_KEY"
      },
      "models": {
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash — Freya",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder-fixed:7b": {
          "name": "Qwen 2.5 Coder 7B (fixed)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen2.5vl": {
          "name": "Qwen 2.5 VL (Vision)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "aratan/gemma-4-E4B-it-heretic:Q6_K": {
          "name": "Gemma 4 E4B Heretic (Q6_K)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },

  // ═══════════════════════════════════════════════════════════════════
  // AGENTS
  // ═══════════════════════════════════════════════════════════════════
  "agent": {
    "gaya": {
      "description": "Divine Commander, Philosopher, Poet of Evergrowth. big-pickle (Zen) → DeepSeek V4 Pro (OpenRouter fallback).",
      "mode": "subagent",
      "model": "zen/big-pickle",
      "temperature": 0.5,
      "fallbackModel": "openrouter/deepseek/deepseek-v4-pro",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "browser": "allow",
        "network": "allow"
      }
    },
    "bob": {
      "description": "Builder on Qwen 3 Coder (OpenRouter). Coding, grunt work, scripts.",
      "mode": "subagent",
      "model": "openrouter/qwen/qwen3-coder",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "freya": {
      "description": "Shadow agent on Gemini 2.5 Flash (Google AI). Vision, search, writing, deep reasoning.",
      "mode": "subagent",
      "model": "googleai/gemini-2.5-flash",
      "temperature": 0.7,
      "fallbackModel": "openrouter/qwen/qwen3.6-plus",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "browser": "allow",
        "network": "allow"
      }
    }
  },

  "mcp": {
  }
}
